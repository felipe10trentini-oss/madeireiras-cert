# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# PDFs e planilhas reais de clientes (usados só nos testes locais)
/tests/fixtures/
/tests/modelos-sei/*_files/

# Cache do idioma do OCR (tesseract)
*.traineddata

# estilos dos relatórios (dados de clientes)
*estilos*.json
# saídas de análise (dados de clientes)
*.jsonl
public/_tmp/
